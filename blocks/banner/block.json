{
	"name": "acf/banner",
	"title": "バナー",
	"description": "バナーを挿入します。",
	"category": "theme-original",
	"icon": "block-default",
	"keywords": ["banner", "バナー"],
	"acf": {
	  "mode": "auto",
	  "renderTemplate": "banner.php"
	},

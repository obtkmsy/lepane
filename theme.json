{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"color": {
			"defaultDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"link": true,
			"palette": [
				{
					"name": "Default",
					"color": "#000000",
					"slug": "default"
				},
				{
					"name": "Primary",
					"color": "#8fc04a",
					"slug": "primary"
				},
				{
					"name": "Secondary",
					"color": "#D17882",
					"slug": "secondary"
				},
				{
					"name": "Gray",
					"color": "#EFEFEF",
					"slug": "gray"
				},
				{
					"name": "Red",
					"color": "#B91B24",
					"slug": "red"
				},
				{
					"name": "Background Primary",
					"color": "#FFF2F1",
					"slug": "background-primary"
				},
				{
					"name": "Background Secondary",
					"color": "#F2F8E4",
					"slug": "background-secondary"
				},
				{
					"name": "Background Tertiary",
					"color": "#FAF7F2",
					"slug": "background-tertiary"
				},
				{
					"name": "White",
					"color": "#FFF",
					"slug": "white"
				},
				{
					"name": "transparent",
					"color": "transparent",
					"slug": "transparent"
				}
			]
		},
		"layout": {
			"contentSize": "1100px",
			"wideSize": "1240px"
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": false,
			"textTransform": true,
			"customFontSize": true,
			"fluid": {
				"maxViewportWidth": "1160px",
				"minViewportWidth": "375px"
			},
			"fontSizes": [
				{
					"name": "非常に小さいサイズ",
					"slug": "xx-small",
					"size": "0.8125rem",
					"fluid": {
						"min": "0.625rem",
						"max": "0.8125rem"
					}
				},
				{
					"name": "通常より小さいサイズ",
					"slug": "x-small",
					"size": "0.9375rem",
					"fluid": {
						"min": "0.75rem",
						"max": "0.9375rem"
					}
				},
				{
					"name": "小さめのサイズ",
					"slug": "small",
					"size": "1rem",
					"fluid": {
						"min": "0.8125rem",
						"max": "1rem"
					}
				},
				{
					"name": "標準的なサイズ",
					"slug": "medium",
					"size": "1.125rem",
					"fluid": {
						"min": "0.875rem",
						"max": "1.125rem"
					}
				},
				{
					"name": "大きめのサイズ",
					"slug": "large",
					"size": "1.275rem",
					"fluid": {
						"min": "0.875rem",
						"max": "1.275rem"
					}
				},
				{
					"name": "通常より大きいサイズ",
					"slug": "x-large",
					"size": "1.875rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "非常に大きいサイズ",
					"slug": "xx-large",
					"size": "2.125rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.125rem"
					}
				}
			],
			"fontFamilies": [
				{
					"name": "Japanese Font",
					"slug": "body",
					"fontFamily": "\"Zen Kaku Gothic New\", \"ヒラギノ角ゴ ProN\", \"Hiragino Kaku Gothic ProN\", \"メイリオ\", Meiryo sans-serif"
				},
				{
					"name": "English Font",
					"slug": "decoration",
					"fontFamily": "\"Roboto\", sans-serif"
				},
				{
					"name": "Mincho Font",
					"slug": "decoration",
					"fontFamily": "\"Zen Old Mincho\", sans-serif"
				}
			]
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"spacingScale": {
				"steps": 0
			},
			"defaultSpacingSizes": false,
			"customSpacingSize": true,
			"spacingSizes": [
				{
					"name": "非常に小さめ 16/10",
					"size": "clamp(0.625rem, 0.446rem + 0.76vw, 1rem)",
					"slug": "2x-small"
				},
				{
					"name": "通常より小さめ 20/20",
					"size": "1.25rem",
					"slug": "x-small"
				},
				{
					"name": "小さめ 30/30",
					"size": "1.875rem",
					"slug": "small"
				},
				{
					"name": "標準 50/40",
					"size": "clamp(2.5rem, 2.201rem + 1.27vw, 3.125rem)",
					"slug": "medium"
				},
				{
					"name": "大きめ 60/50",
					"size": "clamp(3.125rem, 2.826rem + 1.27vw, 3.75rem)",
					"slug": "large"
				},
				{
					"name": "通常より大きめ 100/70",
					"size": "clamp(4.375rem, 3.479rem + 3.82vw, 6.25rem)",
					"slug": "x-large"
				},
				{
					"name": "非常に大きめ 120/80",
					"size": "clamp(5rem, 3.806rem + 5.1vw, 7.5rem)",
					"slug": "2x-large"
				},
				{
					"name": "さらに非常に大きめ 200/100",
					"size": "clamp(6.25rem, 3.264rem + 12.74vw, 12.5rem)",
					"slug": "3x-large"
				},
				{
					"name": "レスポンシブ 80/40",
					"size": "clamp(2.5rem, 1.306rem + 5.1vw, 5rem)",
					"slug": "responsive-80-40"
				},
				{
					"name": "レスポンシブ 100/60",
					"size": "clamp(3.75rem, 2.556rem + 5.1vw, 6.25rem)",
					"slug": "responsive-100-60"
				},
				{
					"name": "レスポンシブ 20/10",
					"size": "clamp(0.625rem, 0.326rem + 1.27vw, 1.25rem)",
					"slug": "responsive-20-10"
				}
			],
			"units": [
				"%", "px", "em", "rem", "vh", "vw"
			]
		},
		"shadow": {
			"presets": [
			]
		},
		"blocks": {
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--default)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "2"
		},
		"spacing": {
			"blockGap": "clamp(1.875rem, 1.278rem + 2.55vw, 3.125rem)",
			"padding": {
				"right": "1.875rem",
				"left": "1.875rem"
			}
		},

		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "1.25rem",
						"bottom": "1.25rem"
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"margin": {
						"top": "clamp(2.5rem, 1.903rem + 2.55vw, 3.75rem)",
						"bottom": "clamp(2.5rem, 1.903rem + 2.55vw, 3.75rem)"
					}
				}
			},
			"core/button": {
			},
			"core/media-text": {
				"spacing": {
					"margin": {
						"top": "clamp(3.125rem, 2.528rem + 2.55vw, 4.375rem)",
						"bottom": "clamp(3.125rem, 2.528rem + 2.55vw, 4.375rem)"
					}
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "clamp(1.875rem, 1.576rem + 1.27vw, 2.5rem)",
					"margin": {
						"top": "clamp(1.875rem, 0.979rem + 3.82vw, 3.75rem)",
						"bottom": "clamp(1.875rem, 0.979rem + 3.82vw, 3.75rem)"
					}
				}
			}
		}
	}
}
